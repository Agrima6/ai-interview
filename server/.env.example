PORT=8000
MONGODB_URL=
JWT_SECRET=
OPENROUTER_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Firebase project ID (from the Firebase console) - used to verify Google
# Sign-In ID tokens server-side. No service account / secret key needed.
FIREBASE_PROJECT_ID=

# Set to "production" when deployed - flips cookies to secure/cross-site mode.
NODE_ENV=

# Deployed frontend origin(s), comma-separated if more than one
# (e.g. https://your-app.vercel.app). Required in production for CORS -
# without it the deployed frontend can't call this API at all.
CLIENT_URL=

# AI provider fallback chain, tried in this order: OpenRouter -> Gemini -> Groq.
# Any subset can be set - missing ones are just skipped, not an error.
GEMINI_API_KEY=
GROQ_API_KEY=

# The Google account email that should become Super Admin. On first Google
# sign-in with this exact email, that account is granted role "superadmin".
SUPERADMIN_EMAIL=
