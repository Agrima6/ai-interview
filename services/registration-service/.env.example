SERVICE_NAME=registration-service
PORT=4003
NODE_ENV=development

# Database Configuration
MONGODB_URL=mongodb://127.0.0.1:27017/workmateiq_registration
MONGO_MAX_POOL_SIZE=50
MONGO_CONNECT_TIMEOUT_MS=5000

# Redis Cache
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Queue / Event Bus Configuration
QUEUE_PROVIDER=direct
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EXCHANGE=workmateiq.events
QUEUE_RETRY_ATTEMPTS=5

# Peer Services (REST clients - direct fallbacks)
FORM_SERVICE_URL=http://localhost:4002
FORM_SERVICE_API_KEY=reg-secret
ONBOARDING_SERVICE_URL=http://localhost:4004
ONBOARDING_SERVICE_API_KEY=reg-secret
COMMUNICATION_SERVICE_URL=http://localhost:4005
COMMUNICATION_SERVICE_API_KEY=reg-secret

# Onboarding application URLs
ONBOARDING_BASE_URL=http://localhost:4004
EXPOSE_LOCAL_ONBOARDING_URL=true

# Authentication Secrets & Security
CAPTCHA_SECRET=dev-captcha-secret
INCOMING_SERVICE_KEYS={"api-gateway":"gateway-secret","form-service":"form-secret","onboarding-service":"onboarding-secret","communication-service":"communication-secret"}
SERVICE_PERMISSIONS={"api-gateway":["REGISTRATION_READ"],"form-service":["REGISTRATION_READ"],"onboarding-service":["REGISTRATION_READ"],"communication-service":["REGISTRATION_READ"]}
