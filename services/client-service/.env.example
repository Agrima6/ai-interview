SERVICE_NAME=client-service
PORT=4006
NODE_ENV=development

# Database Configuration
MONGODB_URL=mongodb://127.0.0.1:27017/workmateiq_client
MONGO_MAX_POOL_SIZE=50
MONGO_CONNECT_TIMEOUT_MS=5000

# Redis Cache
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Queue / Event Bus Configuration
QUEUE_PROVIDER=direct
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EXCHANGE=workmateiq.events
QUEUE_RETRY_ATTEMPTS=5

# Downstream / Peer Services (Internal REST direct fallbacks)
AUTH_SERVICE_URL=http://localhost:4001
AUTH_SERVICE_API_KEY=auth-secret
COMMUNICATION_SERVICE_URL=http://localhost:4005
COMMUNICATION_SERVICE_API_KEY=communication-secret

# Authentication Secrets & Security
ACCESS_TOKEN_SECRET=dev-access-secret
INCOMING_SERVICE_KEYS={"api-gateway":"gateway-secret","onboarding-service":"onboarding-secret","dashboard-service":"dashboard-secret"}
SERVICE_PERMISSIONS={"api-gateway":["CLIENT_READ"],"onboarding-service":["CLIENT_WRITE"],"dashboard-service":["CLIENT_READ","STATISTICS_READ"]}
