SERVICE_NAME=client-service
PORT=4006
NODE_ENV=development
MONGODB_URL=mongodb://127.0.0.1:27017/workmateiq_client
ACCESS_TOKEN_SECRET=dev-access-secret

# ==============================================================================
# AWS S3 Configuration (Used for candidate resumes, recordings, proctor snapshots)
# ==============================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_SESSION_TOKEN=
S3_BUCKET_NAME=ai-interview-storage
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ==============================================================================
# AWS SQS Configuration (Optional recording post-processing queue)
# ==============================================================================
SQS_QUEUE_URL_RECORDING_PROCESSING=
AWS_ENDPOINT_URL=

# ==============================================================================
# Internal Service Interconnect
# ==============================================================================
AUTH_SERVICE_URL=http://localhost:4001
COMMUNICATION_SERVICE_URL=http://localhost:4005
FRONTEND_BASE_URL=http://localhost:5173

# ==============================================================================
# Standalone AI Interview Agent (Python FastAPI + LiveKit at D:\WPCL\agent)
# ==============================================================================
AGENT_SERVICE_URL=http://localhost:8000
AGENT_SERVICE_KEY=your_agent_shared_secret

# ==============================================================================
# Inter-Service Authentication & Permissions
# ==============================================================================
INCOMING_SERVICE_KEYS={"api-gateway":"gateway-secret","onboarding-service":"onboarding-secret","dashboard-service":"dashboard-secret"}
SERVICE_PERMISSIONS={"api-gateway":["CLIENT_READ"],"onboarding-service":["CLIENT_WRITE"],"dashboard-service":["CLIENT_READ","STATISTICS_READ"]}
