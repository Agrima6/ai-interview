SERVICE_NAME=communication-service
PORT=4005
NODE_ENV=development

# Database Configuration
MONGODB_URL=mongodb://127.0.0.1:27017/workmateiq_communication
MONGO_MAX_POOL_SIZE=50
MONGO_CONNECT_TIMEOUT_MS=5000

# Redis Cache (Not directly utilized but supported by standard bootstrap)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Queue / Event Bus Configuration
QUEUE_PROVIDER=direct
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EXCHANGE=workmateiq.events
QUEUE_RETRY_ATTEMPTS=5

# Notification Providers
EMAIL_MODE=mock
WHATSAPP_MODE=mock

# Authentication Secrets & Security
INCOMING_SERVICE_KEYS={"api-gateway":"gateway-secret","registration-service":"reg-secret","onboarding-service":"onboarding-secret"}
SERVICE_PERMISSIONS={"api-gateway":["COMMUNICATION_READ"],"registration-service":["COMMUNICATION_WRITE"],"onboarding-service":["COMMUNICATION_WRITE"]}
