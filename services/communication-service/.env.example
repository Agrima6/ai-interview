SERVICE_NAME=communication-service
PORT=4005
NODE_ENV=development
MONGODB_URL=mongodb://127.0.0.1:27017/workmateiq_communication
PUBLIC_BASE_URL=http://localhost:4005

# ==============================================================================
# AWS SQS Configuration (Notification Delivery Queue)
# ==============================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_SESSION_TOKEN=
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/notification-delivery
AWS_ENDPOINT_URL=

# ==============================================================================
# Email Provider Configuration
# Options: "direct" (Resend), "gmail" (SMTP with App Password), "mock" (logs only)
# ==============================================================================
EMAIL_MODE=mock
RESEND_API_KEY=re_123456789
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=no-reply@workmateiq.com

# ==============================================================================
# WhatsApp Provider Configuration (Meta Cloud API)
# Options: "direct" (Meta Cloud API), "mock" (logs only)
# ==============================================================================
WHATSAPP_MODE=mock
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_token

# ==============================================================================
# Inter-Service Authentication & Permissions
# ==============================================================================
INCOMING_SERVICE_KEYS={"api-gateway":"gateway-secret","registration-service":"reg-secret","onboarding-service":"onboarding-secret","client-service":"client-secret"}
SERVICE_PERMISSIONS={"api-gateway":["COMMUNICATION_READ"],"registration-service":["COMMUNICATION_WRITE"],"onboarding-service":["COMMUNICATION_WRITE"],"client-service":["COMMUNICATION_WRITE"]}
