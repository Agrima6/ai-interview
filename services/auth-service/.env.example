SERVICE_NAME=auth-service
PORT=4001
NODE_ENV=development

# Database Configuration
MONGODB_URL=mongodb://127.0.0.1:27017/workmateiq_auth
MONGO_MAX_POOL_SIZE=50
MONGO_CONNECT_TIMEOUT_MS=5000

# Redis Cache
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Queue / Event Bus Configuration
QUEUE_PROVIDER=direct
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EXCHANGE=workmateiq.events
QUEUE_RETRY_ATTEMPTS=5

# Downstream / Peer Services (Internal REST direct fallbacks)
CLIENT_SERVICE_URL=http://localhost:4006
CLIENT_SERVICE_API_KEY=client-secret
COMMUNICATION_SERVICE_URL=http://localhost:4005
COMMUNICATION_SERVICE_API_KEY=communication-secret

# Authentication secrets
ACCESS_TOKEN_SECRET=dev-access-secret
REFRESH_TOKEN_SECRET=dev-refresh-secret
FIREBASE_PROJECT_ID=demo-project

# Incoming Service Auth
INCOMING_SERVICE_KEYS={"api-gateway":"gateway-secret","onboarding-service":"onboarding-secret","client-service":"client-secret","dashboard-service":"dashboard-secret","enquiry-service":"enquiry-secret"}
SERVICE_PERMISSIONS={"api-gateway":["AUTH_READ","USER_READ"],"onboarding-service":["AUTH_WRITE"],"client-service":["AUTH_READ"],"dashboard-service":["AUTH_READ"],"enquiry-service":["AUTH_READ"]}
