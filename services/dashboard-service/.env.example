SERVICE_NAME=dashboard-service
PORT=4007
NODE_ENV=development

# Redis Cache
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Peer Services (REST clients)
ONBOARDING_SERVICE_URL=http://localhost:4004
ONBOARDING_SERVICE_API_KEY=dashboard-secret
CLIENT_SERVICE_URL=http://localhost:4006
CLIENT_SERVICE_API_KEY=dashboard-secret
ENQUIRY_SERVICE_URL=http://localhost:4008
ENQUIRY_SERVICE_API_KEY=dashboard-secret

# Authentication Secrets & Security
ACCESS_TOKEN_SECRET=dev-access-secret
INCOMING_SERVICE_KEYS={"api-gateway":"gateway-secret"}
SERVICE_PERMISSIONS={"api-gateway":["DASHBOARD_READ"]}
