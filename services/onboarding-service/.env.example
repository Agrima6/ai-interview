SERVICE_NAME=onboarding-service
PORT=4004
NODE_ENV=development

# Database Configuration
MONGODB_URL=mongodb://127.0.0.1:27017/workmateiq_onboarding
MONGO_MAX_POOL_SIZE=50
MONGO_CONNECT_TIMEOUT_MS=5000

# Redis Cache & Autosave Drafts
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Queue / Event Bus Configuration
QUEUE_PROVIDER=direct
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EXCHANGE=workmateiq.events
QUEUE_RETRY_ATTEMPTS=5
OUTBOX_POLL_INTERVAL_MS=2000

# File Storage Configuration (development=local, production=s3)
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads
S3_BUCKET_NAME=workmateiq-onboarding-files
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock-access-key-id
AWS_SECRET_ACCESS_KEY=mock-secret-access-key

# Peer Services (REST clients - direct fallbacks)
FORM_SERVICE_URL=http://localhost:4002
FORM_SERVICE_API_KEY=onboarding-secret
CLIENT_SERVICE_URL=http://localhost:4006
CLIENT_SERVICE_API_KEY=onboarding-secret
AUTH_SERVICE_URL=http://localhost:4001
AUTH_SERVICE_API_KEY=onboarding-secret
COMMUNICATION_SERVICE_URL=http://localhost:4005
COMMUNICATION_SERVICE_API_KEY=onboarding-secret

# Client App URLs
CLIENT_LOGIN_URL=http://localhost:5173/platform/client/login

# Authentication Secrets & Security
ACCESS_TOKEN_SECRET=dev-access-secret
CAPTCHA_SECRET=dev-captcha-secret
INCOMING_SERVICE_KEYS={"api-gateway":"gateway-secret","registration-service":"reg-secret","form-service":"form-secret","client-service":"client-secret","auth-service":"auth-secret","communication-service":"communication-secret","dashboard-service":"dashboard-secret"}
SERVICE_PERMISSIONS={"api-gateway":["ONBOARDING_READ"],"registration-service":["ONBOARDING_WRITE","INVITATION_CREATE"],"form-service":["ONBOARDING_READ"],"client-service":["ONBOARDING_READ"],"auth-service":["ONBOARDING_READ"],"communication-service":["ONBOARDING_WRITE"],"dashboard-service":["STATISTICS_READ"]}
