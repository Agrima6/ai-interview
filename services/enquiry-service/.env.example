SERVICE_NAME=enquiry-service
PORT=4008
NODE_ENV=development

# Database Configuration
MONGODB_URL=mongodb://127.0.0.1:27017/workmateiq_enquiry
MONGO_MAX_POOL_SIZE=50
MONGO_CONNECT_TIMEOUT_MS=5000

# Redis Cache
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Queue / Event Bus Configuration
QUEUE_PROVIDER=direct
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EXCHANGE=workmateiq.events
QUEUE_RETRY_ATTEMPTS=5

# Authentication Secrets & Security
ACCESS_TOKEN_SECRET=dev-access-secret
INCOMING_SERVICE_KEYS={"api-gateway":"gateway-secret","dashboard-service":"dashboard-secret"}
SERVICE_PERMISSIONS={"api-gateway":["ENQUIRY_READ"],"dashboard-service":["ENQUIRY_READ","STATISTICS_READ"]}
