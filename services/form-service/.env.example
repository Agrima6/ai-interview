SERVICE_NAME=form-service
PORT=4002
NODE_ENV=development

# Database Configuration
MONGODB_URL=mongodb://127.0.0.1:27017/workmateiq_form
MONGO_MAX_POOL_SIZE=50
MONGO_CONNECT_TIMEOUT_MS=5000

# Redis Cache
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Authentication Secrets & Security
ACCESS_TOKEN_SECRET=dev-access-secret
INCOMING_SERVICE_KEYS={"api-gateway":"gateway-secret","registration-service":"reg-secret","onboarding-service":"onboarding-secret"}
SERVICE_PERMISSIONS={"api-gateway":["FORM_READ"],"registration-service":["FORM_READ"],"onboarding-service":["FORM_READ"]}
