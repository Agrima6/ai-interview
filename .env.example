# ==============================================================================
# WorkmateIQ AI Interview Platform — Master Environment Configuration Reference
# ==============================================================================
# This file provides a consolidated reference for all services across the platform.
# Copy relevant sections to each individual service's `.env` file as needed.

# ==============================================================================
# 1. API Gateway (services/api-gateway/.env)
# ==============================================================================
# PORT=4000
# NODE_ENV=development
# ALLOWED_ORIGINS=https://workmateiq.com,https://www.workmateiq.com,http://localhost:5173,http://localhost:3000
# AUTH_SERVICE_URL=http://localhost:4001
# REGISTRATION_SERVICE_URL=http://localhost:4003
# FORM_SERVICE_URL=http://localhost:4002
# ONBOARDING_SERVICE_URL=http://localhost:4004
# CLIENT_SERVICE_URL=http://localhost:4006
# COMMUNICATION_SERVICE_URL=http://localhost:4005
# DASHBOARD_SERVICE_URL=http://localhost:4007
# ENQUIRY_SERVICE_URL=http://localhost:4008

# ==============================================================================
# 2. Auth Service (services/auth-service/.env)
# ==============================================================================
# PORT=4001
# MONGODB_URL=mongodb://127.0.0.1:27017/workmateiq_auth
# ACCESS_TOKEN_SECRET=your_access_token_secret
# REFRESH_TOKEN_SECRET=your_refresh_token_secret
# FIREBASE_PROJECT_ID=demo-project
# SEED_ADMIN_EMAIL=admin@yourcompany.com
# SEED_ADMIN_PASSWORD=YourStrongAdminPassword123!

# ==============================================================================
# 3. Client Service (services/client-service/.env)
# ==============================================================================
# PORT=4006
# MONGODB_URL=mongodb://127.0.0.1:27017/workmateiq_client
# ACCESS_TOKEN_SECRET=your_access_token_secret
# FRONTEND_BASE_URL=http://localhost:5173
#
# --- AWS S3 Object Storage ---
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=ai-interview-storage
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
#
# --- AWS SQS Recording Processing Queue ---
# SQS_QUEUE_URL_RECORDING_PROCESSING=
# AWS_ENDPOINT_URL=
#
# --- Standalone Python AI Interview Agent (D:\WPCL\agent) ---
# AGENT_SERVICE_URL=http://localhost:8000
# AGENT_SERVICE_KEY=your_agent_shared_secret

# ==============================================================================
# 4. Communication Service (services/communication-service/.env)
# ==============================================================================
# PORT=4005
# MONGODB_URL=mongodb://127.0.0.1:27017/workmateiq_communication
# PUBLIC_BASE_URL=http://localhost:4005
#
# --- AWS SQS Notification Delivery Queue ---
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_REGION=us-east-1
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/notification-delivery
# AWS_ENDPOINT_URL=
#
# --- Email Provider ---
# EMAIL_MODE=mock                       # Options: "direct" (Resend), "gmail" (SMTP), "mock"
# RESEND_API_KEY=                       # Required if EMAIL_MODE=direct
# GMAIL_USER=                           # Required if EMAIL_MODE=gmail
# GMAIL_APP_PASSWORD=                   # Required if EMAIL_MODE=gmail
# DEFAULT_FROM_EMAIL=no-reply@workmateiq.com
#
# --- WhatsApp Provider (Meta Cloud API) ---
# WHATSAPP_MODE=mock                    # Options: "direct" (Meta Cloud API), "mock"
# WHATSAPP_PHONE_NUMBER_ID=             # Required if WHATSAPP_MODE=direct
# WHATSAPP_ACCESS_TOKEN=                # Required if WHATSAPP_MODE=direct

# ==============================================================================
# 5. Onboarding Service (services/onboarding-service/.env)
# ==============================================================================
# PORT=4004
# MONGODB_URL=mongodb://127.0.0.1:27017/workmateiq_onboarding
# ACCESS_TOKEN_SECRET=your_access_token_secret
# CLIENT_LOGIN_URL=http://localhost:5173/platform/client/login
# CAPTCHA_SECRET=your_captcha_secret
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=ai-interview-storage

# ==============================================================================
# 6. Standalone Python AI Voice Agent (D:\WPCL\agent\.env)
# ==============================================================================
# DATABASE_URL=sqlite:///./workmate.db
# API_BASE_URL=http://localhost:8000
# AGENT_SERVICE_KEY=your_agent_shared_secret
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your_livekit_api_key
# LIVEKIT_API_SECRET=your_livekit_api_secret
# OPENAI_API_KEY=your_openai_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# TTS_PROVIDER=edge                     # Options: "edge", "sarvam", "elevenlabs", "openai"
# TTS_VOICE=aditya
# SARVAM_API_KEY=your_sarvam_api_key
