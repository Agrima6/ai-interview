VITE_RAZORPAY_KEY_ID=

# Deployed backend URL, no trailing slash (e.g. https://your-api.onrender.com).
# Leave unset for local dev - it falls back to http://localhost:8000.
VITE_SERVER_URL=

# Firebase client config (from the Firebase console -> Project settings ->
# your web app). These are public client identifiers, not secrets.
VITE_FIREBASE_APIKEY=
VITE_FIREBASE_AUTHDOMAIN=
VITE_FIREBASE_PROJECTID=
VITE_FIREBASE_APPID=
